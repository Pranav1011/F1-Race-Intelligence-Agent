# ============================================
# F1 Race Intelligence Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ============================================
# LLMs (all optional)
# ============================================
# The agent tries every provider that has a key, in this order:
#   OpenAI -> Groq -> DeepSeek -> Gemini -> local Ollama
# With no keys at all it runs on local Ollama only. Leave a key blank to
# skip that provider.

# OpenAI (gpt-4o, gpt-4o-mini for planning)
OPENAI_API_KEY=

# Groq (llama-3.3-70b-versatile; free tier)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=

# DeepSeek (deepseek-reasoner)
DEEPSEEK_API_KEY=

# Google Gemini (gemini-2.0-flash-exp; free tier)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# Local Ollama (always last in the chain). Pull the model first:
#   ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
# Outside Docker the backend talks to http://localhost:11434 by default;
# docker-compose overrides this with http://ollama:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Observability (Optional but recommended)
# ============================================

# Langfuse - LLM Tracing (Free tier available)
# Get your keys at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry - Error Tracking (Free tier available)
# Get your DSN at: https://sentry.io/
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================
# RAG Enhancement (Optional)
# ============================================

# Cohere - Reranking (Free tier: 1000 reranks/month)
# Get your key at: https://dashboard.cohere.com/
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Content Scraping (Optional)
# ============================================

# Reddit API - For community content ingestion
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Database Configuration (Docker defaults)
# ============================================
# These are pre-configured for Docker Compose
# Only change if running databases externally

# TIMESCALE_URI=postgresql://f1:f1_password@localhost:5432/f1_telemetry
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=f1_password
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# REDIS_URL=redis://localhost:6379

# ============================================
# Application Settings
# ============================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Origins allowed to call the API (comma-separated). Default:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
